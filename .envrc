use flake

# Zig needs a writable cache; also strip Nix macro-prefix-map flags that zig doesn't accept.
export ZIG_GLOBAL_CACHE_DIR="$PWD/.zig-cache"
export ZIG_LOCAL_CACHE_DIR="$PWD/.zig-cache"
if [ -n "${NIX_CFLAGS_COMPILE:-}" ]; then
  export NIX_CFLAGS_COMPILE="$(echo "$NIX_CFLAGS_COMPILE" | sed -E 's/-fmacro-prefix-map=[^ ]+//g' | xargs)"
fi
