#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$root"

data_path="/tmp/openzl-bench-data"
profile="serial"
iters="5"
csv_out=""
tsv_out=""
cpuset="${OPENZL_BENCH_CPUSET:-0}"
data_bytes="${OPENZL_BENCH_BYTES:-52428800}"
data_min="${OPENZL_BENCH_MIN:-0}"
data_max="${OPENZL_BENCH_MAX:-63}"
data_seed="${OPENZL_BENCH_SEED:-12345}"
no_verify=0

usage() {
  cat <<'USAGE'
Usage: ./bench_all [data_path_or_dir] [profile] [iters] [options]

Options:
  --csv FILE        Write results to FILE in CSV format
  --tsv FILE        Write results to FILE in TSV format
  --cpuset CPUSET   CPU set string for taskset/numactl (default: 0)
  --bytes N         Bytes to generate for default dataset (default: 52428800)
  --min N           Min byte value for default dataset (default: 0)
  --max N           Max byte value for default dataset (default: 63)
  --seed N          Deterministic seed for default dataset (default: 12345)
  --no-verify       Skip checksum verification of existing dataset
  -h, --help        Show this help
USAGE
}

while [ $# -gt 0 ]; do
  case "$1" in
    --csv)
      csv_out="${2:-}"; shift 2;;
    --tsv)
      tsv_out="${2:-}"; shift 2;;
    --cpuset)
      cpuset="${2:-}"; shift 2;;
    --bytes)
      data_bytes="${2:-}"; shift 2;;
    --min)
      data_min="${2:-}"; shift 2;;
    --max)
      data_max="${2:-}"; shift 2;;
    --seed)
      data_seed="${2:-}"; shift 2;;
    --no-verify)
      no_verify=1; shift;;
    -h|--help)
      usage; exit 0;;
    --*)
      echo "Unknown option: $1" >&2; usage; exit 1;;
    *)
      if [ -z "${data_path_set:-}" ]; then
        data_path="$1"; data_path_set=1; shift; continue
      elif [ -z "${profile_set:-}" ]; then
        profile="$1"; profile_set=1; shift; continue
      elif [ -z "${iters_set:-}" ]; then
        iters="$1"; iters_set=1; shift; continue
      else
        echo "Unexpected argument: $1" >&2; usage; exit 1
      fi
      ;;
  esac
done

if [ -n "$csv_out" ] && [ -n "$tsv_out" ]; then
  echo "Only one of --csv or --tsv may be specified." >&2
  exit 1
fi

if [ -d "$data_path" ] || [[ "$data_path" == */ ]]; then
  data_file="${data_path%/}/bench.bin"
else
  data_file="$data_path"
fi

verify_flag=()
if [ $no_verify -eq 1 ]; then
  verify_flag=(--no-verify)
fi

./tools/gen_bench_data --output "$data_file" \
  --bytes "$data_bytes" --min "$data_min" --max "$data_max" --seed "$data_seed" \
  "${verify_flag[@]}"

pin_cmd=()
if command -v taskset >/dev/null 2>&1; then
  pin_cmd=(taskset -c "$cpuset")
elif command -v numactl >/dev/null 2>&1; then
  pin_cmd=(numactl --physcpubind="$cpuset")
elif command -v schedtool >/dev/null 2>&1; then
  pin_cmd=(schedtool -a "$cpuset")
else
  echo "Warning: no CPU affinity tool found (taskset/numactl/schedtool). Running without pinning." >&2
fi

run_bench() {
  local label="$1"
  local bin="$2"
  local out line input_bytes output_bytes ratio comp_mbps decomp_mbps

  if [ -x "$bin" ]; then
    if [ ${#pin_cmd[@]} -gt 0 ]; then
      out="$("${pin_cmd[@]}" "$bin" benchmark "$data_file" -n "$iters" -p "$profile" 2>&1)"
    else
      out="$("$bin" benchmark "$data_file" -n "$iters" -p "$profile" 2>&1)"
    fi
  else
    echo "Missing binary: $bin" >&2
    exit 1
  fi

  line="$(printf '%s\n' "$out" | tr '\r' '\n' | tail -n 1 | sed -E $'s/\x1B\\[[0-9;]*[A-Za-z]//g')"

  input_bytes="$(echo "$line" | awk '{for(i=1;i<=NF;i++) if($i=="files:"){print $(i+1); exit}}')"
  output_bytes="$(echo "$line" | awk '{for(i=1;i<=NF;i++) if($i=="->"){print $(i+1); exit}}')"
  ratio="$(echo "$line" | awk '{for(i=1;i<=NF;i++) if($i ~ /^\(.+\),?$/){gsub(/[(),]/,"",$i); print $i; exit}}')"
  comp_mbps="$(echo "$line" | awk '{for(i=1;i<=NF;i++) if($i=="MB/s"){print $(i-1); exit}}')"
  decomp_mbps="$(echo "$line" | awk '{count=0; for(i=1;i<=NF;i++) if($i=="MB/s"){count++; if(count==2){print $(i-1); exit}}}')"

  echo "${label}|${ratio}|${comp_mbps}|${decomp_mbps}|${input_bytes}|${output_bytes}"
}

rows=()
rows+=("$(run_bench "make" "./zli")")
rows+=("$(run_bench "cmake-clang" "./build/cli/zli")")
rows+=("$(run_bench "cmake-zig" "./build-zig2/cli/zli")")

headers=("Build" "Ratio" "Comp_MBps" "Decomp_MBps" "InBytes" "OutBytes")
widths=()
for i in "${!headers[@]}"; do widths[$i]=${#headers[$i]}; done
for row in "${rows[@]}"; do
  IFS='|' read -r -a cols <<< "$row"
  for i in "${!cols[@]}"; do
    if [ ${#cols[$i]} -gt ${widths[$i]} ]; then
      widths[$i]=${#cols[$i]}
    fi
  done
done

print_sep() {
  printf '+'
  for w in "${widths[@]}"; do
    printf '%*s+' $((w + 2)) '' | tr ' ' '-'
  done
  printf '\n'
}

print_row() {
  IFS='|' read -r -a cols <<< "$1"
  printf '|'
  for i in "${!cols[@]}"; do
    printf ' %-*s |' "${widths[$i]}" "${cols[$i]}"
  done
  printf '\n'
}

print_sep
print_row "$(IFS='|'; echo "${headers[*]}")"
print_sep
for row in "${rows[@]}"; do
  print_row "$row"
done
print_sep

if [ -n "$csv_out" ] || [ -n "$tsv_out" ]; then
  out_file="$csv_out"
  delim=","
  if [ -n "$tsv_out" ]; then
    out_file="$tsv_out"
    delim=$'\t'
  fi
  {
    printf 'Build%sRatio%sComp_MBps%sDecomp_MBps%sInBytes%sOutBytes%sIters%sProfile%sDataPath\n' \
      "$delim" "$delim" "$delim" "$delim" "$delim" "$delim" "$delim" "$delim"
    for row in "${rows[@]}"; do
      IFS='|' read -r b r c d inb outb <<< "$row"
      printf '%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s%s\n' \
        "$b" "$delim" "$r" "$delim" "$c" "$delim" "$d" "$delim" "$inb" "$delim" "$outb" \
        "$delim" "$iters" "$delim" "$profile" "$delim" "$data_file"
    done
  } > "$out_file"
fi
